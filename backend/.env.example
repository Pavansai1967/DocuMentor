[TEMPLATE]
# Required. Get it from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Cluster0 > Connect > Connect your application > copy the connection string,
# replace <db_password> and use databaseName=documentor_db.
MONGODB_URI=

# Optional overrides (defaults match these values)
MONGODB_DB_NAME=documentor_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Required for chat. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# LLM models (one per agent node, each has its own rate-limit bucket)
PLAN_MODEL=qwen/qwen3.6-27b
EVALUATE_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b

# Agent config
MAX_AGENT_ITERATIONS=2
DEFAULT_TOP_K=3
MAX_ACCUMULATED_CHUNKS=10

# Comma-separated allowed origins for the frontend (Vite dev server)
CORS_ORIGINS=http://localhost:5173
